# Gemini API key (agent orchestrator) - genuinely free, no credit card
# 1. Go to https://aistudio.google.com/apikey
# 2. Sign in with a Google account, click "Create API key"
# 3. Copy it below
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# SerpApi key (real product search via Google Shopping) - free, no credit card
# 1. Go to https://serpapi.com/users/sign_up
# 2. After signing up, your key is on your dashboard: https://serpapi.com/manage-api-key
# 3. Free plan: 250 searches/month
SERPAPI_KEY=your-serpapi-key-here

# Default country/language for search results (SerpApi gl/hl params)
SEARCH_COUNTRY=in
SEARCH_LANGUAGE=en

# Cache TTL in seconds for product listings
CACHE_TTL_SECONDS=1800
