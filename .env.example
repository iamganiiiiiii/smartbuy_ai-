# Gemini API key (agent orchestrator) - genuinely free, no credit card
# 1. Go to https://aistudio.google.com/apikey
# 2. Sign in with a Google account, click "Create API key"
# 3. Copy it below
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# SerpApi key (real product search via Google Shopping) - free, no credit card
# 1. Go to https://serpapi.com/users/sign_up
# 2. After signing up, your key is on your dashboard: https://serpapi.com/manage-api-key
# 3. Free plan: 250 searches/month
SERPAPI_KEY=your-serpapi-key-here

# Default country/language for search results (SerpApi gl/hl params)
SEARCH_COUNTRY=in
SEARCH_LANGUAGE=en

# Cache TTL in seconds for product listings
CACHE_TTL_SECONDS=1800

# Where the user/subscription SQLite database file lives
DB_PATH=app/data/smartbuy.db

# Free searches a new account gets before the API requires a subscription
FREE_TRIAL_LIMIT=5

# Razorpay (subscription billing) - https://dashboard.razorpay.com/app/keys
# Start in TEST MODE (test key id/secret) before switching to live keys.
# RAZORPAY_PLAN_ID must be created once via the Razorpay dashboard
# (Subscriptions -> Plans) - it defines the monthly price the user is
# charged; this app only ever references its id, never the amount itself.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_PLAN_ID=your-razorpay-plan-id

# Resend (transactional email) - https://resend.com/api-keys
# Free tier works out of the box with EMAIL_FROM left as onboarding@resend.dev
# (no domain verification needed); switch to your own verified domain later.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=SmartBuy AI <onboarding@resend.dev>

# Where the frontend is served - embedded in password-reset email links.
# Update this once the app has a real deployed URL.
FRONTEND_URL=http://127.0.0.1:5180
